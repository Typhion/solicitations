# Copy to .env on the server (/opt/sollicitations/.env). NEVER commit the real file.
#
# The deploy workflow overwrites ONLY the WEB_IMAGE / API_IMAGE lines (SHA-pinned)
# on each deploy and preserve everything else — so the Postgres secrets below live
# only on the server and are set once at bootstrap.

# Image tags (placeholders; CI replaces with ghcr.io/...:<sha>)
WEB_IMAGE=ghcr.io/typhion/sollicitations-web:latest
API_IMAGE=ghcr.io/typhion/sollicitations-api:latest

# Postgres — set a strong, random password on the server
POSTGRES_DB=sollicitations
POSTGRES_USER=sollicitations
POSTGRES_PASSWORD=change-me-to-a-long-random-secret

# API secrets. JWT_KEY must be >= 32 chars: `openssl rand -hex 32`.
# SEED_ADMIN_PASSWORD seeds the first admin account; it must be >= 12 chars with
# upper + lower + digit + symbol. Change it after first login.
JWT_KEY=
SEED_ADMIN_PASSWORD=

# SMTP for invite emails (any transactional provider: Brevo, Postmark, Resend, Mailgun, SES…).
# Leave EMAIL_HOST empty to disable sending. Set SPF/DKIM for the from-domain at the provider.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=noreply@typhion.com
EMAIL_FROM_NAME=Solicitations

# Google Maps Platform (see README "Google Maps"). Leave the server key empty to disable address
# verification (addresses are then free text only, never on the map).
#   SERVER key: Places API (New) only, restricted to this server's IP. Never sent to browsers.
#   BROWSER key: Maps JavaScript API only, restricted to https://admin.typhion.com/* referrers.
#   MAP_ID: a Map ID from Google Cloud (Map Management); DEMO_MAP_ID works but isn't for production.
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
