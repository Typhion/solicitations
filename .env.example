# Copy to .env to override the local dev default in docker-compose.yml (Postgres only).
# LOCAL DEV value only. The API's Jwt:Key and Seed:AdminPassword come from user-secrets
# (cd backend && make secret KEY=Jwt:Key VALUE='...'); production secrets live only in
# the server's /opt/sollicitations/.env (see deploy/README.md).
POSTGRES_PASSWORD=devpassword
