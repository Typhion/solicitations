@WebApi_HostAddress = http://localhost:5182

### Health check
GET {{WebApi_HostAddress}}/
Accept: text/plain

### Login as admin (success) — captures the JWT into {{auth_token}}
# @name login
POST {{WebApi_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "admin"
}

> {%
    client.test("login succeeds", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
    });
    client.global.set("auth_token", response.body.token);
%}

### Login with wrong password (expect 401)
POST {{WebApi_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "wrong"
}

> {%
    client.test("wrong password is rejected", function () {
        client.assert(response.status === 401, "Expected 401 but got " + response.status);
    });
%}

### Get current user with the captured token (expect 200 -> "admin")
# Run the "Login as admin" request first so {{auth_token}} is set.
GET {{WebApi_HostAddress}}/api/me
Authorization: Bearer {{auth_token}}

> {%
    client.test("authenticated request succeeds", function () {
        client.assert(response.status === 200, "Expected 200 but got " + response.status);
    });
%}

### Get current user without a token (expect 401)
GET {{WebApi_HostAddress}}/api/me

> {%
    client.test("missing token is rejected", function () {
        client.assert(response.status === 401, "Expected 401 but got " + response.status);
    });
%}

### Save the preferred language (expect 204; next login's token carries a "locale" claim)
PUT {{WebApi_HostAddress}}/api/account/language
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{ "language": "nl" }

> {%
    client.test("language saved", function () {
        client.assert(response.status === 204, "Expected 204 but got " + response.status);
    });
%}

### Unsupported language, asked in Dutch (expect 400 with a Dutch message)
PUT {{WebApi_HostAddress}}/api/account/language
Content-Type: application/json
Accept-Language: nl-BE
Authorization: Bearer {{auth_token}}

{ "language": "fr" }

> {%
    client.test("unsupported language returns 400", function () {
        client.assert(response.status === 400, "Expected 400 but got " + response.status);
    });
    client.test("message is Dutch", function () {
        client.assert(JSON.stringify(response.body).indexOf("Taal moet") >= 0, "Expected a Dutch message");
    });
%}

### Not-found error in Dutch (expect 404, detail '"Sollicitatie" (…) is niet gevonden.')
GET {{WebApi_HostAddress}}/api/solicitations/00000000-0000-0000-0000-000000000000
Accept-Language: nl
Authorization: Bearer {{auth_token}}

> {%
    client.test("detail is Dutch", function () {
        client.assert(response.status === 404, "Expected 404 but got " + response.status);
        client.assert(response.body.detail.indexOf("is niet gevonden") >= 0, "Expected a Dutch detail");
    });
%}
